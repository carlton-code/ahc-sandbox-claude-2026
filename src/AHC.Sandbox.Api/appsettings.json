{
  "ConnectionStrings": {
    "AdventureWorksLt": "Server=localhost;Database=AdventureWorks;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Redis": {
    // Required per-environment. Supply via env var (Redis__Configuration) or user secrets.
    // Empty/missing now fails validation at startup (fail-fast) rather than silently not caching.
    "Configuration": "",
    "UseTls": true,
    "ConnectTimeoutMs": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
